{
  "hallmark-linter": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node skills/hallmark/scripts/lint-hook.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
